            int afterQuantity-->
    <update id="batchRollbackStocks">
        update product_stock
        set  available_quantity = case
        <foreach collection="productStocks" item="productStock">
            when product_id = #{productStock.productId,jdbcType=BIGINT}
                then #{productStock.availableQuantity,jdbcType=INTEGER}
        </foreach>
        ELSE available_quantity
            END,
        total_out_quantity = case
        <foreach collection="productStocks" item="productStock">
            when product_id = #{productStock.productId,jdbcType=BIGINT}
                then #{productStock.totalOutQuantity,jdbcType=INTEGER}
        </foreach>
        ELSE total_out_quantity
            END,
            version = version + 1,
        update_time = #{now,jdbcType=TIMESTAMP}
        where is_deleted = 0
          and product_id in
        <foreach collection="productStocks" item="productStock"
                 separator="," open="(" close=")">
            #{productStock.productId,jdbcType=BIGINT}
        </foreach>
    </update>
</mapper>
