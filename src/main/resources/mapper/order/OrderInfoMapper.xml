<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.orderinventory.order.mapper.OrderInfoMapper">

    <resultMap id="BaseResultMap" type="com.example.orderinventory.order.entity.OrderInfo">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="orderNo" column="order_no" jdbcType="VARCHAR"/>
            <result property="buyerId" column="buyer_id" jdbcType="BIGINT"/>
            <result property="orderStatus" column="order_status" jdbcType="TINYINT"/>
            <result property="totalAmount" column="total_amount" jdbcType="BIGINT"/>
            <result property="totalQuantity" column="total_quantity" jdbcType="INTEGER"/>
            <result property="cancelReason" column="cancel_reason" jdbcType="VARCHAR"/>
            <result property="remark" column="remark" jdbcType="VARCHAR"/>
            <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
            <result property="isDeleted" column="is_deleted" jdbcType="TINYINT"/>
            <result property="version" column="version" jdbcType="INTEGER"/>
    </resultMap>

    <resultMap id="selectOrderInfoWithOrderItemResultMap"
               type="com.example.orderinventory.order.mapper.model.OrderDetailQueryResult">
        <id column="order_no" property="orderNo"/>
        <result column="buyer_id" property="buyerId"/>
        <result column="order_status" property="orderStatus"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="total_quantity" property="totalQuantity"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <collection property="items"
                    ofType="com.example.orderinventory.order.mapper.model.OrderDetailItemQueryResult">
            <id column="item_product_id" property="productId"/>
            <result column="item_sku_code" property="skuCode"/>
            <result column="item_product_name" property="productName"/>
            <result column="item_sale_price" property="salePrice"/>
            <result column="item_quantity" property="quantity"/>
            <result column="item_amount" property="itemAmount"/>
        </collection>

    </resultMap>

<!--auto generated by MybatisCodeHelper on 2026-07-27
【学习】
这里需不需要在where 中写  AND version = ?
适合业务要求：
    只要订单的任何字段被别人改过，本次取消都必须失败并重试。
第一版先不写
-->
    <update id="cancelCreatedOrder">
        update order_info
        set order_status=#{targetStatus,jdbcType=TINYINT},
            cancel_reason=#{cancelReason,jdbcType=VARCHAR},
            update_time=#{updateTime,jdbcType=TIMESTAMP},
            version= version + 1
        where order_no = #{orderNo,jdbcType=VARCHAR}
        and order_status =  #{expectedStatus,jdbcType=TINYINT}
        and is_deleted = 0
    </update>

<!--auto generated by MybatisCodeHelper on 2026-07-31-->
    <select id="selectOrderDetailByOrderNo" resultMap="selectOrderInfoWithOrderItemResultMap">
        SELECT
        oi.order_no       AS order_no,
        oi.buyer_id       AS buyer_id,
        oi.order_status   AS order_status,
        oi.total_amount   AS total_amount,
        oi.total_quantity AS total_quantity,
        oi.remark         AS remark,
        oi.create_time    AS create_time,
        oi.update_time    AS update_time,

        item.product_id   AS item_product_id,
        item.sku_code     AS item_sku_code,
        item.product_name AS item_product_name,
        item.sale_price   AS item_sale_price,
        item.quantity     AS item_quantity,
        item.item_amount  AS item_amount

        FROM order_info oi

        LEFT JOIN order_item item
        ON item.order_id = oi.id
        AND item.is_deleted = 0

        WHERE oi.order_no = #{orderNo, jdbcType=VARCHAR}
        AND oi.is_deleted = 0

        ORDER BY item.id ASC
    </select>
</mapper>
